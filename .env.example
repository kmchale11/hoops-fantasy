# Copy to .env.local and fill in.

# Where league data comes from: "mock" (built-in fictional season) or "nbn23" (not available yet).
FEED_SOURCE=mock
# Which stage of the mock season to serve: 1, 2 or 3 (see src/ingestion/feed/mock/season.ts).
MOCK_STAGE=3

# Postgres connection string. Locally: the URL `supabase start` prints.
# In production: Supabase → Connect → Session pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Long random strings, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Supabase Auth. Locally: the API URL and keys `supabase start` prints.
# In production: Supabase → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never expose to the browser. Used to delete accounts.
SUPABASE_SECRET_KEY=

# Google sign-in, read by `supabase start` (see supabase/config.toml). From Google Cloud →
# Credentials → OAuth client ID (Web), with redirect URI http://127.0.0.1:54321/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Push notifications on the website and installed web app (Web Push). Generate a key pair once
# with `npm run vapid-keys` and keep the same pair: changing it stops every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can contact us: a mailto: or https: URL.
VAPID_SUBJECT=mailto:hello@hoopsfantasy.ie

# The production build (VERCEL_ENV=production) fails if the three Web Push settings above are
# missing. Set NATIVE_PUSH_ENABLED=true once the iOS and Android apps are live: from then on the
# production build also requires the three Firebase settings below.
NATIVE_PUSH_ENABLED=false

# Push notifications in the iOS and Android apps (Firebase Cloud Messaging). From Firebase →
# Project settings → Service accounts → Generate new private key; copy these three fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with its line breaks written as \n, in quotes.
FIREBASE_PRIVATE_KEY=

# Native app links (invite and sign-in links that open the app). Served at /.well-known/.
# The Apple Developer team ID that signs the iOS app.
APPLE_TEAM_ID=
# SHA-256 fingerprints of the Android signing certificates, comma-separated (Play Console →
# Setup → App signing; include the upload key's too).
ANDROID_CERT_SHA256=
